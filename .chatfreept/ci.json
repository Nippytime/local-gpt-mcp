{
  "version": 1,
  "commands": {
    "policy": [
      [
        "@python",
        "workflow/self_test.py"
      ],
      [
        "@python",
        "workflow/check_workflow_policy.py"
      ]
    ],
    "format": [
      [
        "@python",
        "-m",
        "ruff",
        "format",
        "--check",
        "."
      ]
    ],
    "lint": [
      [
        "@python",
        "-m",
        "ruff",
        "check",
        "."
      ]
    ],
    "typecheck": [
      [
        "@python",
        "-m",
        "mypy"
      ]
    ],
    "unit": [
      [
        "@python",
        "-m",
        "pytest",
        "-q"
      ]
    ],
    "coverage": [
      [
        "@python",
        "-m",
        "pytest",
        "-q",
        "--cov=src/local_gpt_mcp",
        "--cov-report=term",
        "--cov-fail-under=80"
      ]
    ],
    "build": [
      [
        "@python",
        "-m",
        "build",
        "--no-isolation"
      ]
    ],
    "audit": [
      [
        "@python",
        "-m",
        "pip_audit",
        "-r",
        "ci/requirements-ci.txt",
        "--strict"
      ]
    ],
    "secrets": [
      [
        "@python",
        "workflow/check_secrets.py"
      ]
    ],
    "browser": [
      [
        "@python",
        "-m",
        "pytest",
        "-q",
        "browser_integration"
      ]
    ],
    "adversarial": [
      [
        "@python",
        "-m",
        "pytest",
        "-q",
        "tests/security"
      ]
    ],
    "sbom": [
      [
        "@python",
        "ci/generate_sbom.py"
      ]
    ],
    "release_blockers": [
      [
        "@python",
        "workflow/check_release_blockers.py"
      ]
    ]
  },
  "stages": {
    "fast": [
      "policy",
      "format",
      "lint",
      "typecheck",
      "unit"
    ],
    "pr": [
      "policy",
      "unit",
      "coverage",
      "build"
    ],
    "audit": [
      "audit",
      "secrets"
    ],
    "release": [
      "release_blockers",
      "policy",
      "format",
      "lint",
      "typecheck",
      "unit",
      "coverage",
      "audit",
      "secrets",
      "build"
    ],
    "browser": [
      "browser"
    ],
    "security": [
      "adversarial",
      "sbom"
    ]
  },
  "quality": {
    "max_pr_files": 80,
    "max_pr_changed_lines": 4000,
    "max_cyclomatic_complexity": 15,
    "require_issue_for_todo": true
  }
}
