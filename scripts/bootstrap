#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=scripts/lib/python.sh
. "$ROOT/scripts/lib/python.sh"
SYSTEM_PYTHON="$(resolve_system_python)"
CI_MODE=false
if [[ "${1:-}" == "--ci" ]]; then CI_MODE=true; shift; fi
if [[ "$#" -ne 0 ]]; then echo 'Usage: ./scripts/bootstrap [--ci]' >&2; exit 2; fi
if [[ ! -f "$ROOT/pyproject.toml" ]]; then echo 'Missing project manifest.' >&2; exit 1; fi
if [[ ! -f "$ROOT/ci/requirements-ci.txt" ]]; then echo 'Missing CI dependencies.' >&2; exit 1; fi
if [[ ! -x "$ROOT/.venv/bin/python" && ! -x "$ROOT/.venv/Scripts/python.exe" ]]; then
  "$SYSTEM_PYTHON" -m venv "$ROOT/.venv"
fi
VENV_PYTHON="$(resolve_python "$ROOT")"
if [[ "$VENV_PYTHON" == "$SYSTEM_PYTHON" ]]; then echo 'Virtual environment unavailable.' >&2; exit 1; fi
"$VENV_PYTHON" -m pip install --disable-pip-version-check -r "$ROOT/ci/requirements-ci.txt"
"$VENV_PYTHON" -m pip install --disable-pip-version-check --no-deps -e "$ROOT"
for module in pytest ruff mypy pip_audit build; do
  "$VENV_PYTHON" -c "import importlib; importlib.import_module('$module')" || { echo "Missing CI tool: $module" >&2; exit 1; }
done
if [[ "$CI_MODE" == false ]]; then
  "$VENV_PYTHON" -m pre_commit install --hook-type pre-commit --hook-type pre-push
fi
printf 'Bootstrap ready with %s\n' "$VENV_PYTHON"
